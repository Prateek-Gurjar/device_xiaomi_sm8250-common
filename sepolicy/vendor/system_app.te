# CPU hotplug controls exposed by XiaomiParts.
allow system_app vendor_sysfs_corecontrol:dir search;
allow system_app vendor_sysfs_corecontrol:file { getattr open read write };

# CPU frequency governor and policy controls exposed by the munch kernel.
allow system_app sysfs_devices_system_cpu:dir search;
allow system_app sysfs_devices_system_cpu:file { getattr open read write };
