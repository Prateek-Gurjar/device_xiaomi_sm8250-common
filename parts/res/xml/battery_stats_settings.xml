<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreference android:key="battery_stats_notification_enabled"
        android:title="@string/battery_stats_notification_title"
        android:summary="@string/battery_stats_notification_summary"
        android:defaultValue="false" />
    <PreferenceCategory android:title="@string/battery_stats_metrics">
        <SwitchPreference android:key="battery_stats_show_active_drain"
            android:title="@string/battery_stats_active_drain"
            android:summary="@string/battery_stats_active_drain_summary"
            android:defaultValue="true" />
        <SwitchPreference android:key="battery_stats_show_idle_drain"
            android:title="@string/battery_stats_idle_drain"
            android:summary="@string/battery_stats_idle_drain_summary"
            android:defaultValue="true" />
        <SwitchPreference android:key="battery_stats_show_charging"
            android:title="@string/battery_stats_charging_label"
            android:defaultValue="true" />
        <SwitchPreference android:key="battery_stats_show_charge_time"
            android:title="@string/battery_stats_charge_time"
            android:defaultValue="true" />
        <SwitchPreference android:key="battery_stats_show_remaining_time"
            android:title="@string/battery_stats_remaining_time"
            android:defaultValue="true" />
        <SwitchPreference android:key="battery_stats_show_temperature"
            android:title="@string/battery_stats_temperature_label"
            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/battery_stats_reset_category">
        <SwitchPreference android:key="battery_stats_auto_reset"
            android:title="@string/battery_stats_auto_reset"
            android:summary="@string/battery_stats_auto_reset_summary"
            android:defaultValue="true" />
        <SwitchPreference android:key="battery_stats_reset_on_charger"
            android:title="@string/battery_stats_reset_on_charger"
            android:summary="@string/battery_stats_reset_on_charger_summary"
            android:dependency="battery_stats_auto_reset"
            android:defaultValue="true" />
        <SwitchPreference android:key="battery_stats_reset_on_reboot"
            android:title="@string/battery_stats_reset_on_reboot"
            android:summary="@string/battery_stats_reset_on_reboot_summary"
            android:dependency="battery_stats_auto_reset"
            android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
